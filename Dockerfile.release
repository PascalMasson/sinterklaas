# syntax=docker/dockerfile:1.7

ARG APP_BASE_IMAGE=serversideup/php:8.5-fpm-nginx-alpine

FROM node:22-alpine AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY resources ./resources
COPY public ./public
COPY vite.config.js .
RUN npm run build

FROM ${APP_BASE_IMAGE} AS release-base

USER root
RUN install-php-extensions intl gd exif bcmath excimer \
    && docker-php-serversideup-dep-install-alpine mysql-client execline \
    && sed -i '/X-Frame-Options/d' /etc/nginx/server-opts.d/security.conf
COPY --chmod=755 docker/base/entrypoint.d/ /etc/entrypoint.d/
COPY --chmod=755 docker/release/entrypoint.d/ /etc/entrypoint.d/
COPY docker/base/http.conf /etc/nginx/site-opts.d/http.conf

FROM release-base AS dependencies
WORKDIR /var/www/html
USER root
COPY composer.json composer.lock ./
RUN --mount=type=secret,id=composer_auth,target=/run/secrets/composer_auth \
    set -eu; \
    if [ -s /run/secrets/composer_auth ]; then export COMPOSER_AUTH="$(cat /run/secrets/composer_auth)"; fi; \
    composer install --prefer-dist --no-dev --no-interaction --no-progress --no-autoloader --no-scripts

FROM release-base AS runtime
WORKDIR /var/www/html
USER root
COPY . .
COPY --from=dependencies /var/www/html/vendor ./vendor
COPY --from=frontend /build/public/build ./public/build
RUN rm -rf /var/www/html/.env* /var/www/html/auth.json /var/www/html/.npmrc \
    && mkdir -p bootstrap/cache storage/app/public storage/app/private storage/framework/cache storage/framework/sessions storage/framework/views storage/logs \
    && APP_ENV=testing APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= composer dump-autoload --optimize --no-interaction --no-scripts \
    && APP_ENV=testing APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan package:discover --ansi \
    && if [ -e public/storage ] || [ -L public/storage ]; then rm -rf public/storage; fi \
    && APP_ENV=testing APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan storage:link \
    && chown -R www-data:www-data bootstrap/cache storage
LABEL org.opencontainers.image.title="sinterklaas" \
      org.opencontainers.image.description="Sinterklaas immutable application image"
